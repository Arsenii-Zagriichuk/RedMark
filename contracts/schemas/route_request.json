{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RouteRequest",
  "description": "Body of POST /route. Engine: Person 4; served by Person 1's service.",
  "type": "object",
  "properties": {
    "site": {
      "$ref": "common.json#/$defs/site_id"
    },
    "start": {
      "$ref": "common.json#/$defs/point"
    },
    "goal": {
      "$ref": "common.json#/$defs/point"
    },
    "mode": {
      "title": "RouteMode",
      "type": "string",
      "enum": [
        "fastest",
        "science",
        "cart"
      ],
      "description": "fastest safe route, science alternative, or the cart's route to base camp."
    },
    "uncertainty_m": {
      "type": "number",
      "description": "Current uncertainty circle radius in ground metres; the hazard margin grows with it.",
      "minimum": 0
    },
    "limits": {
      "title": "RouteLimits",
      "description": "The hard limits for this request. Defaults from Artemis planning: 20° slope (15° as an option), 2 km from the habitat, 2 km/h planning speed, about 6 h walk.",
      "type": "object",
      "properties": {
        "max_slope_deg": {
          "type": "number",
          "description": "Steepest slope allowed.",
          "exclusiveMinimum": 0,
          "maximum": 90
        },
        "max_distance_from_habitat_m": {
          "type": "number",
          "description": "Distance from the habitat no point may exceed.",
          "exclusiveMinimum": 0
        },
        "planning_speed_kmh": {
          "type": "number",
          "description": "Planning walk speed.",
          "exclusiveMinimum": 0
        },
        "max_walk_h": {
          "type": "number",
          "description": "Longest walk, exit to re-entry.",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "max_slope_deg",
        "max_distance_from_habitat_m",
        "planning_speed_kmh",
        "max_walk_h"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "site",
    "start",
    "goal",
    "mode",
    "uncertainty_m",
    "limits"
  ],
  "additionalProperties": false
}
